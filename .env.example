# ===================================================================
# Kaabil voice rig - API keys.  Paste values after the "=" sign.
# This file (.env) stays on this machine and is git-ignored.
# Keys are only ever sent to the service they belong to.
# The app's Setup panel shows which slots are filled (never the values).
# ===================================================================

# --- REQUIRED --------------------------------------------------------
# The brain: fills the student profile, asks follow-up questions,
# and plays the simulated students in the dialogue benchmark.
# Get it: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Model to use. Add ":free" at the end to test free (rate-limited).
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl

# --- OPTIONAL --------------------------------------------------------
# Hugging Face read token: faster, un-throttled model downloads; needed
# only for the gated AI4Bharat Indic Parler-TTS (accept its terms first).
# Get it: https://huggingface.co/settings/tokens
HF_TOKEN=

# Sarvam Bulbul: Indian-language cloud voice to compare against.
# Get it: https://dashboard.sarvam.ai
SARVAM_API_KEY=
SARVAM_MODEL=bulbul:v3
SARVAM_SPEAKER=shubh

# ElevenLabs: "best possible" commercial reference voice.
# Get it: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_v3
ELEVENLABS_VOICE_ID=

# Brain reasoning: off (default, measured fastest and most reliable) | low | medium
OPENROUTER_REASONING=off
